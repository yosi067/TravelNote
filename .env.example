Maps_API_KEY=replace-with-your-google-maps-api-key

GATEWAY_PORT=8080
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432

POSTGRES_DB=travel_os
POSTGRES_USER=travel_os_user
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgres://travel_os_user:change-me-for-local-development@database:5432/travel_os

GATEWAY_MEM_LIMIT=128m
FRONTEND_MEM_LIMIT=256m
BACKEND_MEM_LIMIT=384m
DATABASE_MEM_LIMIT=500m

GATEWAY_CPU_LIMIT=0.25
FRONTEND_CPU_LIMIT=0.50
BACKEND_CPU_LIMIT=0.75
DATABASE_CPU_LIMIT=0.75

NODE_ENV=development
CHOKIDAR_USEPOLLING=true
